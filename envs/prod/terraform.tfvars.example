# Copy this file to terraform.tfvars (WITHOUT the .example) and adjust:

project     = "trevol"
domain_name = "trevolcamaguey.com"

# Leave this at false until the AWS email confirming domain registration
# arrives. Then flip it to true and apply again.
domain_active = false

# Where AWS Budgets spend alerts arrive.
alert_email = "your-email@example.com"

monthly_budget_usd = 3

# ---- Notifications (optional, leave "" if not in use yet) ----

# Telegram bot that alerts the business of EVERY new order.
# How to get it: on Telegram, talk to @BotFather -> /newbot -> it gives you
# the token. Then add the bot to your chat/group, message it, and visit
# https://api.telegram.org/bot<TOKEN>/getUpdates to see the "chat":{"id":...}
telegram_bot_token = ""
telegram_chat_id   = ""

# WhatsApp to the customer confirming their order, via Twilio.
# Account at twilio.com -> Account SID and Auth Token are on the dashboard.
# twilio_whatsapp_from is the WhatsApp-enabled number on Twilio
# (the test sandbox uses +14155238886; real production needs a WhatsApp
# sender approved by Meta, and that approval takes a few days).
twilio_account_sid   = ""
twilio_auth_token    = ""
twilio_whatsapp_from = ""

# ---- Worker panel + live delivery tracking (all optional) ----

# Panel for the kitchen/rider: https://<your site>/panel.html
# Leave worker_key empty and Terraform makes one:  terraform output -raw worker_key
# worker_key = ""

# The rider shares Telegram "live location" ONCE per trip in a chat with the
# bot, and customers see the rider approaching. The chat in telegram_chat_id
# is authorized automatically. To authorize another rider: they write /start
# to the bot, the bot replies with their id, and you put it here.
# telegram_worker_ids = "123456789"

# Where deliveries start (you can also move it from the panel with one tap).
# kitchen_lat = 21.3808
# kitchen_lng = -77.9169

# Windows the customer can choose at checkout ("Lo antes posible" is always there).
# Empty = Desayuno 07:00-09:00 and Merienda 15:00-17:00.
# delivery_slots = "[{\"id\":\"desayuno\",\"label\":\"Desayuno\",\"start\":\"07:00\",\"end\":\"09:00\"},{\"id\":\"merienda\",\"label\":\"Merienda\",\"start\":\"15:00\",\"end\":\"17:00\"}]"

# prep_minutes      = 25   # kitchen time for "as soon as possible" estimates
# slot_lead_minutes = 30   # a window stops taking orders this long before it ends
